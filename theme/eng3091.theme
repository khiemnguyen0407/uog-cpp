{
  "text-color": "#1b2a41",
  "background-color": "#f3f5f8",
  "line-number-color": "#8792a2",
  "line-number-background-color": null,
  "text-styles": {
    "Keyword":        { "text-color": "#a3155b", "background-color": null, "bold": false, "italic": false, "underline": false },
    "ControlFlow":    { "text-color": "#a3155b", "background-color": null, "bold": false, "italic": false, "underline": false },
    "DataType":       { "text-color": "#0a5a8a", "background-color": null, "bold": false, "italic": false, "underline": false },
    "BuiltIn":        { "text-color": "#0a5a8a", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Extension":      { "text-color": "#0a5a8a", "background-color": null, "bold": false, "italic": false, "underline": false },
    "String":         { "text-color": "#8a4600", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Char":           { "text-color": "#8a4600", "background-color": null, "bold": false, "italic": false, "underline": false },
    "SpecialChar":    { "text-color": "#8a4600", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "SpecialString":  { "text-color": "#8a4600", "background-color": null, "bold": false, "italic": false, "underline": false },
    "VerbatimString": { "text-color": "#8a4600", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Import":         { "text-color": "#8a4600", "background-color": null, "bold": false, "italic": false, "underline": false },
    "DecVal":         { "text-color": "#0f6e63", "background-color": null, "bold": false, "italic": false, "underline": false },
    "BaseN":          { "text-color": "#0f6e63", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Float":          { "text-color": "#0f6e63", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Constant":       { "text-color": "#0f6e63", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Preprocessor":   { "text-color": "#6f3fa8", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Comment":        { "text-color": "#4f5b6a", "background-color": null, "bold": false, "italic": true,  "underline": false },
    "Documentation":  { "text-color": "#4f5b6a", "background-color": null, "bold": false, "italic": true,  "underline": false },
    "CommentVar":     { "text-color": "#4f5b6a", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "Annotation":     { "text-color": "#4f5b6a", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "Information":    { "text-color": "#4f5b6a", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "Warning":        { "text-color": "#9a5b00", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "Alert":          { "text-color": "#b3261e", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "Error":          { "text-color": "#b3261e", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "Function":       { "text-color": "#1b2a41", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Variable":       { "text-color": "#1b2a41", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Operator":       { "text-color": "#1b2a41", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Attribute":      { "text-color": "#6f3fa8", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Other":          { "text-color": "#1b2a41", "background-color": null, "bold": false, "italic": false, "underline": false }
  }
}
